{
  "compilerOptions": {
    "lib": [
      "dom",
      "es2015",
      "esnext.asynciterable"
    ],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2015",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "contents/**/*.ts"
  ]
}
