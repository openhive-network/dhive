{
  "compilerOptions": {
    "declaration": true,
    "lib": ["dom", "ES7"],
    "module": "commonjs",
    "noImplicitThis": true,
    "outDir": "lib",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "strict": false,
    "strictNullChecks": true,
    "target": "es6",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
