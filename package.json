{
  "name": "@hiveio/dhive",
  "version": "1.2.3",
  "description": "Hive blockchain RPC client library",
  "author": "hive-network",
  "license": "BSD-3-Clause-No-Military-License",
  "main": "./lib/index-node",
  "typings": "./lib/index",
  "browser": {
    "./lib/index-node": "./dist/dhive.js",
    "./src/index-node": "./dist/dhive.js",
    "./src/version": "./lib/version.js"
  },
  "files": [
    "dist/*",
    "lib/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.syncad.com/hive/dhive"
  },
  "scripts": {
    "lint": "eslint -c .eslintrc.json src/** --fix",
    "lint:ci": "eslint -c .eslintrc.json src/**",
    "lint:test": "eslint -c .eslintrc.json --ext .ts test --fix",
    "test": "mocha test/*.ts",
    "test:coverage": "nyc -r text -r cobertura -r lcov -e .ts -i ts-node/register mocha test/*.ts",
    "prepublishOnly": "make all"
  },
  "keywords": [
    "blockchain",
    "client",
    "rpc",
    "hive",
    "dhive"
  ],
  "dependencies": {
    "bs58": "^4.0.1",
    "bytebuffer": "^5.0.1",
    "core-js": "^3.6.4",
    "cross-fetch": "3.1.5",
    "https": "^1.0.0",
    "jsbi": "^3.1.4",
    "node-fetch": "^2.6.0",
    "secp256k1": "^3.8.0",
    "verror": "^1.10.0",
    "whatwg-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.1.6",
    "@babel/preset-env": "^7.1.6",
    "@types/bytebuffer": "^5.0.33",
    "@types/mocha": "9.1.1",
    "@types/node": "18.7.15",
    "@types/verror": "^1.10.3",
    "@typescript-eslint/eslint-plugin": "5.36.1",
    "@typescript-eslint/parser": "5.36.1",
    "babelify": "^10.0.0",
    "browserify": "^16.2.3",
    "coveralls": "^3.0.11",
    "derequire": "^2.0.6",
    "dts-generator": "^2.1.0",
    "encoding": "^0.1.12",
    "eslint": "8.22.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "4.2.1",
    "karma": "^4.4.1",
    "karma-browserify": "^5.1.1",
    "karma-mocha": "^1.3.0",
    "karma-mocha-reporter": "^2.2.5",
    "karma-sauce-launcher": "^1.2.0",
    "lorem-ipsum": "^1.0.6",
    "mocha": "10.0.0",
    "mocha-junit-reporter": "2.0.2",
    "mocha-multi-reporters": "1.5.1",
    "nyc": "15.1.0",
    "prettier": "2.7.1",
    "regenerator-runtime": "^0.13.1",
    "ts-node": "10.9.1",
    "tsify": "^4.0.0",
    "typedoc": "0.23.14",
    "typescript": "4.8.2",
    "uglify-js": "^3.4.9",
    "watchify": "^3.11.0"
  }
}
