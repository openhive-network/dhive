{
  "semi": true,
  "trailingComma": "none",
  "arrowParens": "always",
  "singleQuote": true,
  "printWidth": 180,
  "tabWidth": 3,
  "useTabs": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.json"],
      "options": {
        "tabWidth": 2,
        "useTabs": false
      }
    }
  ]
}

